#!/usr/bin/env python3
"""Resume the most recent Claude Code session for the current directory.

Used as the tmux-resurrect restore command for 'claude' panes (see
@resurrect-strategy-claude in ~/.tmux.conf and tilda/tmux/claude_resume.sh)
so continuum's unattended restore after the nightly reboot doesn't hit the
interactive --resume picker.

The restore runs this script with no arguments, so the flags a given pane
was started with (e.g. --permission-mode=auto) are recovered here by
re-reading tmux-resurrect's own save file, which records the real pane
command line per directory; '--resume'/'-r <id>' in it is replaced with
'-r <id>' for the session found here, and a trailing prompt argument is
dropped. A recovered --permission-mode=auto runs through ~/bin/claude-auto
instead of plain 'claude'. If no saved command is found for this
directory, falls back to plain 'claude'.

Several panes can share a directory, so the newest transcript there is
not necessarily this pane's.  'claude-resume-here --save' (run as
@resurrect-hook-post-save-all) records which session each pane is
running, keyed by session name, window index and pane index, which
restore preserves.  Restore uses that record when it has one.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

PROJECTS = os.path.expanduser("~/.claude/projects")
SESSIONS = os.path.expanduser("~/.claude/sessions")
RESURRECT_DIR = os.path.expanduser("~/.local/share/tmux/resurrect")
PANE_MAP = os.path.join(RESURRECT_DIR, "claude-sessions")
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
PANE_FMT = "#{session_name}\t#{window_index}\t#{pane_index}"


def slug(path):
    return re.sub(r"[^a-zA-Z0-9]", "-", os.path.abspath(path))


def latest_session(path):
    d = os.path.join(PROJECTS, slug(path))
    try:
        names = [n for n in os.listdir(d) if n.endswith(".jsonl")]
    except OSError:
        return None
    best = None
    for n in names:
        full = os.path.join(d, n)
        try:
            mtime = os.path.getmtime(full)
        except OSError:
            continue
        if best is None or mtime > best[0]:
            best = (mtime, n[: -len(".jsonl")])
    return best[1] if best else None


def tmux(*args):
    try:
        return subprocess.run(["tmux"] + list(args), capture_output=True,
                              text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None


def proc_start(pid):
    """Field 22 (starttime) of /proc/<pid>/stat, as Claude records it in
    procStart; None if the process is gone."""
    try:
        with open("/proc/%d/stat" % pid) as f:
            stat = f.read()
    except OSError:
        return None
    # comm (field 2) may hold spaces; fields after it start at index 3.
    return stat.rsplit(")", 1)[1].split()[19]


def live_pane_sessions():
    """{tmux pane id: session id} for running Claude processes."""
    out = {}
    try:
        names = os.listdir(SESSIONS)
    except OSError:
        return out
    for n in names:
        if not n.endswith(".json"):
            continue
        try:
            with open(os.path.join(SESSIONS, n)) as f:
                info = json.load(f)
            pid, sid = int(info["pid"]), info["sessionId"]
            pane = info["tmux"].rsplit(".", 1)[1]
        except (OSError, ValueError, KeyError, IndexError, TypeError,
                AttributeError):
            continue
        # stale files outlive their process; a reused pid has a new start.
        if not UUID_RE.match(sid) or proc_start(pid) != str(info.get("procStart")):
            continue
        out[pane] = sid
    return out


def save_pane_map():
    """Write PANE_MAP: session_name, window_index, pane_index, session id."""
    sessions = live_pane_sessions()
    panes = tmux("list-panes", "-a", "-F", "#{pane_id}\t" + PANE_FMT)
    if panes is None:
        return 1
    lines = []
    for line in panes.splitlines():
        pane_id, _, key = line.partition("\t")
        if pane_id in sessions:
            lines.append("%s\t%s\n" % (key, sessions[pane_id]))
    os.makedirs(RESURRECT_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=RESURRECT_DIR, prefix=".claude-sessions.")
    with os.fdopen(fd, "w") as f:
        f.writelines(lines)
    os.replace(tmp, PANE_MAP)
    return 0


def this_pane_key():
    """(session_name, window_index, pane_index) of the pane we run in."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return None
    out = tmux("display-message", "-p", "-t", pane, PANE_FMT)
    if out is None:
        return None
    key = tuple(out.rstrip("\n").split("\t"))
    return key if len(key) == 3 else None


def saved_session(key):
    """Session id PANE_MAP recorded for this pane, if its transcript
    still exists in the current directory's project."""
    try:
        with open(PANE_MAP) as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    for line in lines:
        fields = line.split("\t")
        if len(fields) != 4 or tuple(fields[:3]) != key:
            continue
        sid = fields[3]
        if not UUID_RE.match(sid):
            return None
        transcript = os.path.join(PROJECTS, slug(os.getcwd()), sid + ".jsonl")
        return sid if os.path.exists(transcript) else None
    return None


def recover_flags(full_cmd):
    """The option arguments of a saved 'claude ...' command line: argv[0],
    any --resume/-r, and the trailing prompt are dropped.  A prompt is
    recognized as an argument holding whitespace, which distinguishes it
    from the value of a preceding option.  None if the line is unparsable."""
    try:
        args = shlex.split(full_cmd)[1:]  # drop argv[0] ("claude")
    except ValueError:
        return None
    out = []
    skip_next = False
    for i, a in enumerate(args):
        if skip_next:
            skip_next = False
            continue
        if a == "--":
            break
        nxt = args[i + 1] if i + 1 < len(args) else None
        takes_value = nxt is not None and not nxt.startswith("-") and \
            not nxt.split()[1:]
        if a in ("--resume", "-r"):
            skip_next = takes_value
            continue
        if not a.startswith("-"):
            break  # the prompt, or something else positional
        out.append(a)
        if takes_value:
            out.append(nxt)
            skip_next = True
    return out


def saved_claude_flags(path, key=None):
    """recover_flags() of the last saved pane command line recorded for
    this directory -- for pane 'key' if it is given and found there --
    or None if none is found."""
    save = os.path.join(RESURRECT_DIR, "last")
    try:
        f = open(save, errors="replace")
    except OSError:
        return None
    found = None
    with f:
        for line in f:
            fields = line.rstrip("\n").split("\t")
            if len(fields) < 10 or fields[0] != "pane":
                continue
            pane_path = fields[7]
            proc_name = fields[9]
            full_cmd = fields[10] if len(fields) > 10 else ""
            if pane_path.lstrip(":") != os.path.abspath(path):
                continue
            if proc_name != "claude":
                continue
            full_cmd = full_cmd.lstrip(":")
            if not full_cmd:
                continue
            if key and (fields[1], fields[2], fields[5]) == key:
                return recover_flags(full_cmd)
            if found is None:
                found = recover_flags(full_cmd)
    return found


def strip_auto_mode(flags):
    """Remove any --permission-mode=auto (or split-form) flag, reporting
    whether one was present."""
    out, is_auto, skip_next = [], False, False
    for i, a in enumerate(flags):
        if skip_next:
            skip_next = False
            continue
        if a == "--permission-mode=auto":
            is_auto = True
            continue
        if a == "--permission-mode" and flags[i + 1 : i + 2] == ["auto"]:
            is_auto, skip_next = True, True
            continue
        out.append(a)
    return out, is_auto


def main():
    if sys.argv[1:] == ["--save"]:
        return save_pane_map()
    cwd = os.getcwd()
    key = this_pane_key()
    flags = saved_claude_flags(cwd, key)
    flags, is_auto = strip_auto_mode(flags if flags is not None else [])
    # claude-auto already adds --permission-mode=auto itself.
    cmd = ["claude-auto" if is_auto else "claude"] + flags
    sid = (key and saved_session(key)) or latest_session(cwd)
    if sid:
        cmd += ["-r", sid]
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    sys.exit(main())
