#!/bin/sh
# Run 'resize-window -A' (the prefix-F binding) on every window in a session.
# Usage: tmux-resize-all [session]   (default: current session)
#
# To bind it to prefix Alt-F, add to .tmux.conf:
#   bind-key M-F run-shell "tmux-resize-all '#{session_id}'"

set -e
if [ -n "$1" ]; then
    target="$1"
elif [ -n "$TMUX" ]; then
    target=$(tmux display-message -p '#{session_id}')
else
    echo "usage: ${0##*/} [session] (or run inside tmux)" >&2
    exit 1
fi

windows=$(tmux list-windows -t "$target" -F '#{window_id}')
set -- $windows
windows="$*"
for win in "$@"; do
    tmux resize-window -A -t "$win" || { echo "resize $win failed"; exit 1; }
done
echo "$(date -R) resized $target [$windows]" >>/tmp/resize.log
